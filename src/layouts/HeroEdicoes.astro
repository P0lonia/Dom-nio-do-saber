<section>
    <div class="carousel">
        <button class="left">←</button>

        <div class="image">
            <span></span>
            <img src="https://cdn.pixabay.com/photo/2017/06/07/06/00/el-salvador-2379443_1280.jpg">
            <img src="https://cdn.pixabay.com/photo/2015/01/31/18/17/arabs-618749_1280.jpg">
            <img src="https://cdn.pixabay.com/photo/2020/08/26/15/25/ideas-5519782_960_720.jpg">
        </div>

        <button class="right">→</button>
    </div>
</section>

<style>
    span {
        position: absolute;
        width: 100%;
        height: 100%;
        z-index: 2;
        background-color: #0016204f;
    }

    .carousel {
        display: flex;
        align-items: center;
        gap: 10px;
        overflow: hidden;
    }

    div.image {
        height: 70vh;
        width: 100%;
        position: relative;
        background-color: currentColor;

        display: flex;
        overflow: hidden;
    }

    div.image img {
        width: 100%;
        object-fit: cover;

        transition: transform 850ms ease-out;
        flex-shrink: 0;
        flex-grow: 0;
    }

    button {
        outline: none;
        border: none;
        top: 43%;
        position: absolute;
        height: 50px;
        width: 50px;
        background-color: #12121252;
        color: #f4f4f4;
        font-size: 34px;
        font-weight: bolder;
        transition: all 250ms linear;
        cursor: pointer;
        z-index: 3;
    }

    button:first-child {
        left: 0;
    }

    button:last-child {
        right: 0;
    }

    button:hover {
        background-color: #121212a6;
    }

    @media (max-width: 768px) {
        button {
            font-size: 18px;
            height: 30px;
            width: 30px;
        }
    }
</style>

<script>
    const left = document.querySelectorAll("button").item(0) as HTMLButtonElement;
    const right = document.querySelectorAll("button").item(1) as HTMLButtonElement;
    const images = document.querySelectorAll(".image img") as NodeListOf<HTMLImageElement>;

    const myDiv = document.querySelector(".image") as HTMLDivElement;

    let imgWidth = myDiv.clientWidth;
    let x = 0;

    window.onresize = function () {
    imgWidth = myDiv.clientWidth;
    x = 0;
    images.forEach(img => img.style.transform = `translateX(0px)`);
    };

    right.onclick = function () {
    if (-x < imgWidth * (images.length - 1)) {
        x -= imgWidth;
    } else {
        x = 0;
    }
    images.forEach(img => img.style.transform = `translateX(${x}px)`);
    };

    left.onclick = function () {
    if (x < 0) {
        x += imgWidth;
    } else {
        x = -(imgWidth * (images.length - 1));
    }
    images.forEach(img => img.style.transform = `translateX(${x}px)`);
    };
</script>