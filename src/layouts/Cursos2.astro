---
import Container from "../components/Container.astro";

---

<Container direction="column">
    <section>
        <h2>Todos os nossos cursos disponíveis:</h2>
        <div class="grid">
            <div class="card">
                <div class="card-info" style="background-color: rgba(26, 94, 60, 0.829); border: 4px solid #0E2A18;">
                    <h3>Leitura dinâmica</h3>
                    <div class="card-back1">
                        <strong>
                            Leia mais rápido, entenda melhor e economize horas de estudo.
                        </strong>
                    </div>
                    <span style="background-color: #67e698;">
                        <img src="/images/Icons/unlock.svg" alt="">
                    </span>
                </div>
                <a href="/cursos/leitura"  class="btn">Acessar</a>
            </div>
            <div class="card">
                <div class="card-info" style="background-color: rgba(73, 40, 126, 0.808); border: 4px solid #2A0F33;">
                    <h3>Memorização</h3>
                    <div class="card-back2">
                        <strong>
                            Grave conteúdos com facilidade e retenha por muito mais tempo.
                        </strong>
                    </div>
                    <span style="background-color: #E6D4FF;">
                        <img src="/images/Icons/unlock.svg" alt="">
                    </span>
                </div>
                <a href="/cursos/memorizacao" class="btn">Acessar</a>
            </div>
            <div class="card">
                <div class="card-info" style="background-color: rgba(241, 181, 15, 0.745); border: 4px solid #5A2A14;">
                    <h3>Técnicas de Estudo</h3>
                    <div class="card-back3">
                        <strong>
                            Aprenda a estudar de forma inteligente e aumente seus resultados sem estudar mais.
                        </strong>
                    </div>
                    <span style="background-color: #fff6a9;">
                        <img src="/images/Icons/unlock.svg" alt="">
                    </span>
                </div>
                <a href="/cursos/tecnicas" class="btn">Acessar</a>
            </div>
        </div>
    </section>
</Container>

<style>
    h2 {
        font-family: "SUSE Mono", sans-serif;
        padding: 64px;
        margin-bottom: 16px;
        color: rgb(21, 69, 131);
        letter-spacing: 1px;
        text-align: center;
    }

    .grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        width: 100%;
        gap: 64px;
        color: white;
    }

    .card {
        width: 100%;
        margin-bottom: 16vh;
    }

    .card h3 {
        text-align: center;
        padding: 16px;
        font-size: 1.5em;
        font-family: "SUSE Mono", sans-serif;
        font-weight: normal;
        letter-spacing: 1px;
    } 

    .card-info {
        display: flex;
        flex-direction: column;
        height: 35vh;
        width: 100%;
        position: relative;
        border-radius: 4px;
        box-shadow: 0 0 22px 1px #00000093;
        margin-bottom: ;
    }

    .card-back1{
        background: linear-gradient(to right,
        rgba(21, 88, 85, 0.4) 10%, 
        rgba(21, 88, 85, 0.2) 35%, 
        rgba(21, 88, 85, 0.2) 50%, 
        rgba(21, 88, 85, 0.4) 100%), url('https://cdn.pixabay.com/photo/2022/01/22/16/54/book-6957870_1280.jpg');
        background-size: cover;
        background-position: center center;
        background-repeat: no-repeat;
        padding: 16px;
        height: 70%;
        text-align: center;
        display: flex;
        align-items: center;
        border-bottom: 6px solid #67e697c2;
        border-top: 4px solid #0E2A18;
        text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.8);
    }

    .card-back2{
        background: linear-gradient(to right,
        rgba(64, 36, 109, 0.4) 10%, 
        rgba(64, 36, 109, 0.2) 35%, 
        rgba(64, 36, 109, 0.2) 50%, 
        rgba(64, 36, 109, 0.4) 100%), url('/images/cursos/brain.png');
        background-size: cover;
        background-position: center center;
        background-repeat: no-repeat;
        padding: 16px;
        height: 70%;
        text-align: center;
        display: flex;
        align-items: center;
        border-bottom: 6px solid #d5c3f0e0;
        border-top: 4px solid #2A0F33;
        text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.8);
    }

    .card-back3{
        background: linear-gradient(to right,
        rgba(107, 84, 20, 0.4) 10%, 
        rgba(107, 84, 20, 0.2) 35%, 
        rgba(107, 84, 20, 0.2) 50%, 
        rgba(107, 84, 20, 0.4) 100%), url('https://cdn.pixabay.com/photo/2022/05/24/04/38/study-7217599_1280.jpg');
        background-size: cover;
        background-position: center center;
        background-repeat: no-repeat;
        padding: 16px;
        height: 70%;
        text-align: center;
        display: flex;
        align-items: center;
        border-bottom: 6px solid #fff6a9de;
        border-top: 4px solid #5A2A14;
        text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.8);
    }

    strong {
        letter-spacing: 2px;
        font-size: 18px;
    }

    .card span {
        border-radius: 50%;
        height: 38px;
        width: 38px;

        display: flex;
        align-items: center;
        justify-content: center;
        position: absolute;
        bottom: 6%;
        right: 45%;
    }

    .btn {
        width: 100%;
        text-align: center;
        background-color: transparent;
        margin-top: 44px;
        padding: 18px;
        border-radius: 32px;
        border: 3px solid rgb(23, 36, 48);
        cursor: pointer;
        display: block;
        color: rgb(23, 36, 48);
        font-weight: bold;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .btn:hover{
        background-color: rgb(23, 36, 48);
        color: white;
        transition: 0.3s ease-in;
    }

    @media (max-width: 768px) {
        section {
            width: 90%;
        }

        .grid {
            grid-template-columns: 1fr;
            gap: 16px;
        }
        .card-info {
            height: 70vh;
        }

        span {
            bottom: 13%;
        }

        .card-back1 {
            height: 80%;
        }
        .card-back2 {
            height: 80%;
        }
        .card-back3 {
            height: 80%;
        }
    }
</style>