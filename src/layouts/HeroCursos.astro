---
import Container from "../components/Container.astro";
import Links from "../components/Links.astro";
---

<div class="hero">
    <span class="overlay"></span>
    <Container maxWidth="1300px" align="center">
    <div class="informacoes-hero">
        <h2>
            Aprenda <br> <span>Da Sua Casa</span> <br> Como quiser!
        </h2>
        <h3>
            Frase para <span>colocar</span>
        </h3>
        <strong>Agora aberto para inscrição:</strong>
        <p>
            Lorem ipsum dolor sit amet consectetur adipisicing elit. Sunt, dolorum pariatur! Necessitatibus minus maxime placeat, quae aut dolorum officiis expedita adipisci perspiciatis quia et ratione. Corrupti, repellendus. Saepe, aut reiciendis!
        </p>
        <Links link="/">
            Inscreva-se 
        </Links>
    </div>
        <img src="/images/cursospage/hero-cursos-img2.png\" alt="">
    </Container>
</div>

<style>
    .overlay {
        width: 100%;
        height: 100%;
        background-color: rgba(30, 84, 128, 0.2);
        z-index: 1;
        position: absolute;
        right: 0;
    }
    .hero{
        height: 70vh;
        width: 100%;
        background: linear-gradient(to right,
        rgba(2, 81, 145, 0.4) 10%, 
        rgba(2, 81, 145, 0.2) 35%, 
        rgba(2, 81, 145, 0.2) 50%, 
        rgba(2, 81, 145, 0.4) 100%), url('/images/cursospage/hero-cursos-bg.png');
        background-size: cover;
        background-position: center center;
        background-repeat: no-repeat;

        display: flex;
        align-items: center;
        color: white;
        position: relative;
    }

    .informacoes-hero {
        display: flex;
        flex-direction: column;
        justify-content: start;
        z-index: 2;
        width: 100%;
    }

    .informacoes-hero h2 {
        font-family: "SUSE Mono", sans-serif;
        font-size: 44px;
        margin-bottom: 22px;
        text-wrap: nowrap;
        font-weight: normal;
    }

    .informacoes-hero span {
        font-family: "SUSE Mono", sans-serif;
        color: rgba(230, 63, 42, 0.966);
        font-weight: bold;
    }

    .informacoes-hero h3 {
        font-family: "SUSE Mono", sans-serif;
        font-size: 32px;
        font-weight: normal;
        margin-bottom: 64px;
    }

    .informacoes-hero strong {
        font-size: 24px;
        font-style: italic;
        margin-bottom: 44px;
        letter-spacing: 2px;
    }

    .informacoes-hero p{
        font-size: 22px;
        font-style: italic;
        margin-bottom: 44px;
    }

    a {
        text-align: center;
        background-color: rgb(255, 115, 0);;
    }

    .hero img {
        width: 100%;
        max-height: 50vh;
        object-fit: contain;
    }

    @media (max-width: 768px) {
        h2 {
            text-align: center;
            font-size: 18px;
        }
    }
</style>