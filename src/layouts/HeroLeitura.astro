---
import Container from "../components/Container.astro";
---

<section>
    <div class="hero">
        <Container>
            <img class="img" src="/images/heros/homemComLivro.png" alt="">
            <div class="informacoes-hero">
                <h2>Curso de <br> <span>Leitura dinâmica</span></h2>
                <span class="linha"></span>
                <img src="/images/Icons/unlock.svg" alt="">
                <p>
                    Desperte o
                    LEITOR
                    que Existe em Você!
                    DESTRAVE
                    o Poder da
                    <strong>LEITURA DINÂMICA.</strong>
                    Conheça o Método Estruturado para Triplicar sua Leitura em 90 Dias!
                </p>
            </div>
            <div class="alert">
                <img src="/images/Icons/teste.svg" alt=""> <strong>Aproveite o nosso <br> <i>conteúdo!</i></strong>
            </div>
        </Container>
    </div>
</section>

<style>
    p {
        margin-bottom: 64px;
        font-size: 16px;
        color: rgb(23, 36, 48);
        font-weight: bolder;
        letter-spacing: 1px;
    }
    .alert {
        position: absolute;
        right: 0;
        bottom: 0;
        background-color: rgb(21, 69, 131);
        color: white;
        width: 40vw;
        height: 10vh;
        border-top: 4px solid rgb(23, 36, 48);
        border-left: 4px solid rgb(23, 36, 48) ;
        display: flex;
        align-items: center;
        padding: 16px;
        font-size: 22px;
        letter-spacing: 1px;
    }
    .alert img {
        height: 35px;
        width: 35px;
        margin-right: 8px;
    }
    .hero{
        padding: 2.8vw;
        height: 50vh;
        width: 100%;
        background: linear-gradient(to right,
        rgba(21, 88, 85, 0.4) 20%, 
        rgba(21, 88, 85, 0.2) 40%, 
        rgba(21, 88, 85, 0.2) 50%, 
        rgba(21, 88, 85, 0.4) 100%), url('/images/heros/heroleitura.jpg');
        background-size: cover;
        background-position: center center;
        background-repeat: no-repeat;

        display: flex;
        align-items: center;
        position: relative;

        border-bottom: 5px solid #0E2A18;
    }

    .informacoes-hero {
        display: flex;
        flex-direction: column;
        justify-content: start;
        width: 100%;
        padding: 16px;
        position: relative;
    }

    .informacoes-hero h2 {
        font-family: "SUSE Mono", sans-serif;
        font-size: 44px;
        margin-bottom: 22px;
        text-wrap: nowrap;
        font-weight: normal;
        text-shadow: 2px 2px 22px rgba(0, 0, 0, 0.5);
        color: rgb(23, 36, 48);
        font-weight: bold;
    }

    .informacoes-hero h2 span {
        color: rgb(23, 36, 48);
        letter-spacing: -4px;
        font-style: italic;
        font-weight: normal;
        font-family: "SUSE Mono", sans-serif;
    }

    .informacoes-hero img{
        padding: 6px;
        border-radius: 50%;
        height: 38px;
        max-width: 38px;
        background-color: #67e698;
        position: absolute;
        bottom: 43.5%;
        left: 48%;
        box-shadow: rgba(0, 0, 0, 0.315) 0px 0px 10px 2px;
    }

    .informacoes-hero .linha {
        width: 100%;
        border-bottom: 4px solid #0E2A18;
        margin-top: 32px;
        margin-bottom: 32px;
    }

    .hero .img {
        width: 100%;
        max-height: 50vh;
        object-fit: contain;
        filter: contrast(1.2) opacity(80%);
    }

    @media (max-width: 768px) {
        p {
            display: none;
        }

        .hero {
            padding: 0 2.8vw;
            height: 45vh;
            align-items: end;

            border-bottom: 4px solid #0E2A18;
        }
        
        .hero .img {
            width: 50%;
        }
        .informacoes-hero h2 {
            font-size: 22px;
            margin-bottom: 0;
        }

        .informacoes-hero img{
            padding: 4px;
            height: 25px;
            max-width: 25px;
            bottom: 5.5vh;
            left: 42%;
        }
        .informacoes-hero .linha {
            border-bottom: 2px solid #0E2A18;
            margin-top: 22px;
        }

        .alert {
            top: 0;
            width: 50vw;
            border-top: none;
            border-bottom: 4px solid rgb(23, 36, 48);
            font-size: 12px;
            text-wrap: nowrap;
        }
        .alert img {
            width: 25px;
            height: 25px;
        }
    }
</style>